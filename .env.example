# Copy to .env and fill in.  scripts/install.sh reads this and installs
# /etc/antigravity-web.env from it (referenced by the systemd unit).

# --- GCP ------------------------------------------------------------------
# The GCP project used for Vertex AI (Anthropic Claude models) and ADC.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Which Anthropic model region on Vertex. "global" is the default and works
# for claude-opus-4-8 and claude-fable-5. Regional endpoints also fine.
MCP_VERTEX_REGION=global

# --- Auth -----------------------------------------------------------------
# CSRF token the injected SPA JavaScript sends and language_server accepts.
# GENERATE A FRESH ONE — do NOT reuse an example value.
# On Linux: `openssl rand -hex 32`
CSRF_TOKEN=antigravity_secret_csrf_token_12345

# (Optional) Google Workspace OAuth credentials. 
# Used by the Go language_server to orchestrate the Workspace MCP server.
OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-oauth-client-secret


# --- Vertex Claude fallback -----------------------------------------------
# If ADC isn't available (rare — should not happen on GCP VMs), the deep-
# research MCP can fall back to a direct Anthropic API key. Leave blank
# to disable the fallback.
ANTHROPIC_API_KEY=

# --- Serving --------------------------------------------------------------
# The public hostname behind your GCP LB (used only by docs, not by code).
# Example: 34.8.231.67.nip.io
PUBLIC_HOSTNAME=your-lb-ip.nip.io

# OPTIONAL — real DNS domain to serve on (removes SSL warnings that some
# clients show for nip.io). If set, scripts/gcp_setup_lb.sh will provision
# the Google-managed SSL cert for THIS name instead of <ip>.nip.io.
#
# You must create an A record pointing this name to the LB's static IP
# BEFORE running the script (Google-managed cert validation loops on DNS).
# Example: PUBLIC_DOMAIN=antigravity.customertests.info
PUBLIC_DOMAIN=

# --- Environment plumbing (usually leave as-is) --------------------------
GOOGLE_GENAI_USE_ENTERPRISE=true
# ADC file — install.sh writes this after `gcloud auth application-default login`
GOOGLE_APPLICATION_CREDENTIALS=/home/YOUR_USER/.config/gcloud/application_default_credentials.json

# --- Bootstrap scripts (only needed by scripts/gcp_setup_*.sh) -----------
# The GCE VM the hub runs on. If you already have one, tag it with
# 'antigravity-web' so the LB firewall rule catches it.
VM_NAME=your-vm-name
VM_ZONE=us-central1-a
VM_MACHINE_TYPE=n4-standard-2
DATA_DISK_GB=100

# Comma-separated IAM members allowed through IAP. Prefix with user: or group:
# Example:  IAP_USERS=user:you@example.com,group:eng@yourcorp.com
IAP_USERS=user:you@example.com

# Optional — prefix for the LB resources (default: antigravity-web)
NAME_PREFIX=antigravity-web
