      "disabled": false,
      "args": [
        "-B",
        "${PLUGIN_ROOT}/src/diagram_renderer/diagram_mcp_server.py"
      ],
      "env": {
        "PLUGIN_ROOT": "${PLUGIN_ROOT}",
